# Core runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mindforge?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
OPENAI_API_KEY=""

# Transactional email. Required for verified sign-up and password reset.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_SECURE="false"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="MindForge <no-reply@example.com>"

# Optional OAuth providers. Buttons are enabled only when both values exist.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Legacy demo/Supabase prototype only. Do not enable it in a production deploy.
NEXT_PUBLIC_DEMO_MODE="true"
