# Core runtime. On Supabase, use the transaction pooler (port 6543) for the
# serverless runtime and the session pooler (port 5432) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Google AI Studio free-tier credential. AI_CHAT_MODEL defaults to the stable
# Gemini 3.5 Flash-Lite model.
GEMINI_API_KEY=""
AI_CHAT_MODEL="gemini-3.5-flash-lite"

# Authentication. Create an application at https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/signin"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/workspace"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/workspace"
# --- Professor voice -------------------------------------------------------
# Speech uses ElevenLabs when a key is present and falls back to Gemini when it
# is not. Set SPEECH_PROVIDER="gemini" to force the fallback.
# Latin is not among the languages ElevenLabs supports; it is approximated.
ELEVENLABS_API_KEY=""
# Single voice for every language. Superseded by ELEVENLABS_VOICE_MAP.
ELEVENLABS_VOICE_ID=""
# Per-language voices, so a native speaker reads each language:
#   "hi=<Devi id>,zh=<Susan id>,default=<Mac id>"
# Voice identifiers are public, not credentials. Copy them from
# ElevenLabs > Voices > My Voices > the row menu > Copy Voice ID.
ELEVENLABS_VOICE_MAP=""
# Defaults to eleven_flash_v2_5: $0.05 per 1K characters and ~75ms, across a
# superset of multilingual v2's languages. eleven_multilingual_v2 is steadier on
# long-form but costs $0.10 per 1K, halving a fixed credit allowance.
ELEVENLABS_MODEL=""
# Sends neighbouring chunks as prosody context. ElevenLabs recommends it but
# does not say whether the context is billed; leave unset while credits matter.
ELEVENLABS_CHUNK_CONTEXT=""
# Voice modulation. Stability low is expressive and variable, high is flat.
# Style above 0 costs latency. Speed accepts 0.7 to 1.2.
ELEVENLABS_STABILITY=""
ELEVENLABS_SIMILARITY=""
ELEVENLABS_STYLE=""
ELEVENLABS_SPEED=""
ELEVENLABS_SPEAKER_BOOST=""

# Origins Clerk will accept sessions for. Comma-separated. Leave empty on
# Vercel, where the deployment hostnames are detected automatically; set it
# explicitly once a custom domain is live. See ops/CLERK_PRODUCTION.md.
CLERK_AUTHORIZED_PARTIES=""
NEXT_PUBLIC_APP_URL=""

# Distributed abuse protection. Required in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Generate with: openssl rand -base64 48
RATE_LIMIT_HASH_SECRET="replace-with-an-independent-random-secret"
# Must be overwritten by your edge/proxy, never passed through from clients.
TRUSTED_PROXY_HEADER="x-forwarded-for"

# Optional public support contact. When omitted, the Support page links to the
# project's GitHub issue tracker.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Scheduled retention endpoint authentication and audit-log lifetime.
CRON_SECRET="replace-with-an-independent-random-secret"
AUDIT_RETENTION_DAYS="365"

# Optional incident/error email alerting via Resend (https://resend.com).
# Leave RESEND_API_KEY or ALERT_EMAIL_TO empty to use platform logs only.
# Without a verified sending domain, ALERT_EMAIL_FROM must stay on
# onboarding@resend.dev, which Resend only delivers to the account's own
# registered email address.
RESEND_API_KEY=""
ALERT_EMAIL_FROM="MindForge Alerts <onboarding@resend.dev>"
ALERT_EMAIL_TO=""
