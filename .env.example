# Public application origin, with no trailing slash.
APP_ORIGIN=https://your-domain.example

# Demo mode (client public). Defaults to "true" when unset. Set to "false" for
# the full server-backed experience. In demo mode none of the values below are
# required; the app runs entirely on the client with mock data.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase: use the public publishable/anon key only in the browser. Every
# user-facing server operation carries the signed user session and is checked by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OAUTH_PROVIDER=google

# OpenAI is called only from route handlers. Use a project key with the data
# retention controls appropriate for your organisation. Responses set store=false.
OPENAI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
# Upstash Redis provides distributed, non-local rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security limits. Keep aligned with your reverse proxy and hosting plan.
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
