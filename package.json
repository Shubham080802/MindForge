{
  "name": "mindforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "sharp": "0.35.4"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "corepack pnpm test:e2e:public",
    "test:e2e:public": "playwright test e2e/public.spec.ts",
    "test:e2e:staging": "node scripts/run-staging-e2e.mjs",
    "audit:prod": "corepack pnpm audit --prod --audit-level high",
    "validate": "corepack pnpm test && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm build",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.19.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.12.1",
    "next": "^15.2.4",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.33",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.4.47",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  }
}
